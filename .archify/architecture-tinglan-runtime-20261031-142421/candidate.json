  "cards": [
    {
      "dot": "cyan",
      "title": "点播到出声",
      "items": [
        "点击歌曲只改队列；模型按代次取消旧解析，切歌不覆盖新请求",
        "播放地址由协议客户端解析，只接受白名单 CDN 与曲目身份一致的响应",
        "音频按 1 MiB Range 分块读入解码器；macOS 只把合成 URL 交给 AVFoundation"
      ]
    },
    {
      "dot": "rose",
      "title": "凭据与信任边界",
      "items": [
        "系统授权窗口只回传 hms:// 回调；密码与 Cookie 不进入应用",
        "音乐会话只存在于协议层与保险库；AES-GCM 密文与密钥同文件",
        "应用数据目录 0700、文件 0600，拒绝符号链接；文件权限即边界",
        "第三方歌词只发送歌名、艺人、时长，可在设置关闭"
      ]
    },
    {
      "dot": "emerald",
      "title": "支撑细节",
      "items": [
        "单个 Go 二进制 + Viva 渲染；无 Electron、无本地 HTTP 服务、无辅助进程",
        "收藏分页到短页后按 contentID 去重；账号缓存以 snsUserID 哈希隔离",
        "系统媒体集成：Now Playing / SMTC / MPRIS 与主线程派发",
        "macOS 实机；Windows 包已构建但未实机验收；Linux 仅交叉编译"
      ]
    }
  ]
}